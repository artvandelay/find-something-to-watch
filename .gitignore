# secrets and personal data — never commit
.env
.env.*
NetflixViewingHistory.csv
*ViewingHistory*.csv

# raw source dumps (large, rebuildable) — fixtures are the exception
data/*
!data/fixtures/
!data/fixtures/**

# node (fflate is vendored into docs/js/vendor for the static site)
node_modules/

# python
__pycache__/
*.py[cod]
.venv/

# tmdb sweep artifacts (large, rebuildable)
catalog/*.db
catalog/*.db-wal
catalog/*.db-shm
catalog/*.lock
catalog/*.log
catalog/__pycache__/

# os
.DS_Store

# Understand-Anything scratch (keep knowledge-graph.json / meta / fingerprints)
.ua/.trash-*/
.ua/tmp/
.ua/.DS_Store
